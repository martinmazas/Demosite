# Base URL used as baseURL in playwright.config.ts (page.goto('/') resolves against this)
BASE_URL=https://demoqa.com/books

# Root URL for API requests (used in APIRequestContext)
API_BASE_URL=https://demoqa.com

# Credentials for the test account used in auth setup
TEST_USERNAME=your_test_user
TEST_PASSWORD=your_test_password
